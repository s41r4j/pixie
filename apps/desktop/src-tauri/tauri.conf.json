{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pixie",
  "version": "0.7.7",
  "identifier": "com.openclicky.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Pixie",
        "width": 720,
        "height": 460,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "overlay",
        "title": "Pixie overlay",
        "width": 800,
        "height": 600,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "shelf",
        "title": "Pixie jobs",
        "width": 340,
        "height": 700,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled"
      },
      {
        "label": "guide",
        "title": "Pixie",
        "width": 440,
        "height": 130,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: slot: http://slot.localhost; font-src 'self' slot: http://slot.localhost; media-src 'self' slot: http://slot.localhost; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../../resources/": "resources/",
      "../../extension/": "extension/",
      "../../../skills/": "skills/"
    },
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": "-"
    },
    "externalBin": [
      "binaries/openclicky-helper",
      "binaries/openclicky-voice"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQjBFMjFGNzBBMTFGNUUKUldSZUg2RndIK0t3bzJTTW5DWEtjSFRhbEZFRjROVzFIUnNDMEREN1BoZkVCWU1TQUtPc1dVY2oK",
      "endpoints": [
        "https://github.com/s41r4j/pixie/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
