{
  "name": "OpenClicky Pixel Design System",
  "version": "1.0.0",
  "identity": {
    "mark": ":)",
    "style": "monochrome pixel",
    "approvedReference": "references/approved-design-sheet.png"
  },
  "primitives": {
    "black": "#000000",
    "ink": "#080808",
    "deep": "#141414",
    "charcoal": "#404040",
    "mid": "#A0A0A0",
    "silver": "#E5E5E5",
    "white": "#FFFFFF"
  },
  "palettes": {
    "dark": {
      "canvas": "#000000",
      "surface": "#080808",
      "raised": "#141414",
      "foreground": "#FFFFFF",
      "secondary": "#E5E5E5",
      "muted": "#A0A0A0",
      "border": "#404040",
      "borderStrong": "#FFFFFF",
      "selectedBackground": "#FFFFFF",
      "selectedForeground": "#000000",
      "disabled": "#404040"
    },
    "light": {
      "canvas": "#FFFFFF",
      "surface": "#FFFFFF",
      "raised": "#E5E5E5",
      "foreground": "#000000",
      "secondary": "#404040",
      "muted": "#404040",
      "border": "#A0A0A0",
      "borderStrong": "#000000",
      "selectedBackground": "#000000",
      "selectedForeground": "#FFFFFF",
      "disabled": "#A0A0A0"
    },
    "highContrast": {
      "canvas": "#000000",
      "surface": "#000000",
      "raised": "#000000",
      "foreground": "#FFFFFF",
      "secondary": "#FFFFFF",
      "muted": "#FFFFFF",
      "border": "#FFFFFF",
      "borderStrong": "#FFFFFF",
      "selectedBackground": "#FFFFFF",
      "selectedForeground": "#000000",
      "disabled": "#FFFFFF"
    },
    "dither": {
      "canvas": "#000000",
      "surface": "#080808",
      "raised": "#141414",
      "foreground": "#FFFFFF",
      "secondary": "#E5E5E5",
      "muted": "#A0A0A0",
      "border": "#404040",
      "borderStrong": "#FFFFFF",
      "selectedBackground": "#FFFFFF",
      "selectedForeground": "#000000",
      "disabled": "#404040",
      "pattern": "../assets/patterns/bayer25-32.png"
    }
  },
  "typography": {
    "display": {
      "family": "Press Start 2P",
      "fallback": "monospace",
      "sizes": [
        12,
        16,
        20,
        24,
        32
      ],
      "lineHeight": 1.45
    },
    "ui": {
      "family": "VT323",
      "fallback": "monospace",
      "sizes": [
        18,
        22,
        26,
        30
      ],
      "lineHeight": 1.1
    },
    "body": {
      "family": "IBM Plex Mono",
      "fallback": "monospace",
      "sizes": [
        12,
        14,
        16
      ],
      "lineHeight": 1.55
    },
    "fontFilesBundled": false
  },
  "geometry": {
    "gridPx": 4,
    "pixelGrid": {
      "glyph": 16,
      "appIcon": 64,
      "illustration": 960
    },
    "strokePx": [
      1,
      2,
      4
    ],
    "chamferPx": [
      4,
      8,
      12
    ],
    "radiiPx": [
      0
    ],
    "shadow": "4px 4px 0 #404040",
    "antiAlias": "off for pixel art; on for regular body text"
  },
  "spacePx": {
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "section": 64
  },
  "componentSizesPx": {
    "appIcon": {
      "logical": 64,
      "bundleMax": 1024
    },
    "systemIcon": [
      16,
      24,
      32
    ],
    "trayIcon": {
      "pt": 22,
      "retinaPx": 44
    },
    "pill": {
      "width": 320,
      "height": 48,
      "minWidth": 180
    },
    "notchCollapsed": {
      "width": 380,
      "height": 48
    },
    "notchExpanded": {
      "width": 420,
      "height": 640
    },
    "edgeJobCard": {
      "width": 300,
      "height": 96
    },
    "noteCard": {
      "width": 420
    },
    "button": {
      "sm": 32,
      "md": 40,
      "lg": 48
    },
    "touchTarget": 44,
    "overlayTargetBorder": 2
  },
  "motion": {
    "tapMs": 80,
    "hoverMs": 100,
    "panelMs": 160,
    "stateMs": 120,
    "easing": "steps(3,end)",
    "reducedMotion": "no steps, no looping, still clear"
  },
  "audio": {
    "format": "WAV 44.1kHz mono 16-bit; enter and eshop MP3",
    "maxPeakDbFS": -3,
    "uiGain": 0.7,
    "agentGain": 0.8,
    "ambientGain": 0.35,
    "voiceDucksAmbientTo": 0.3,
    "maxConcurrency": "1 UI + 1 bed + 1 voice"
  },
  "screenOverlay": {
    "default": "pixel-border",
    "strokePx": 2,
    "halo": "none",
    "ditheredFill": true
  },
  "rules": {
    "color": "Grayscale only; no accent hues",
    "shadows": "hard-edged only; never blurred",
    "gradients": "Dither ordered textures, never smooth gradients",
    "icons": "Pixel aligned, no anti-aliasing, preserve integer scaling",
    "accessibility": "Do not use sound alone; visible focus; reduced motion; voice always optional"
  }
}
