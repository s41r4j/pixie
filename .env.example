# Copy to .env (repo root, for dev) or ~/Library/Application Support/com.openclicky.app/.env
# You can also paste keys in Settings → AI. Claude is used first when its key is set.

# DeepSeek (Anthropic-compatible endpoint, deepseek-flash has vision)
DEEPSEEK=
# DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_DEEP_MODEL=deepseek-flash

# Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Force one: deepseek | claude
# OPENCLICKY_PROVIDER=
