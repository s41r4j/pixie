{
  "name": "openclicky",
  "private": true,
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "dev": "npm run tauri -w apps/desktop -- dev",
    "build": "npm run build -w apps/desktop",
    "tauri": "npm run tauri -w apps/desktop --",
    "app:build": "npm run tauri -w apps/desktop -- build",
    "app:build:universal": "npm run tauri -w apps/desktop -- build --target universal-apple-darwin",
    "placeholders": "node scripts/gen-placeholders.mjs",
    "check": "cargo check --workspace && npm run build",
    "test": "cargo test --workspace",
    "assets:local": "node scripts/local-assets.mjs"
  }
}
